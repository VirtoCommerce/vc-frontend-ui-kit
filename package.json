{
  "name": "@vc-frontend/ui-kit",
  "version": "0.0.0",
  "description": "UI kit of the Virto Commerce storefront: Vc* components, styles, tokens, Tailwind preset and color presets",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtoCommerce/vc-frontend-ui-kit.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.vue"
  ],
  "files": [
    "dist",
    "vite"
  ],
  "exports": {
    ".": "./dist/index.ts",
    "./components": "./dist/components/index.ts",
    "./components/atoms": "./dist/components/atoms/index.ts",
    "./components/molecules": "./dist/components/molecules/index.ts",
    "./components/organisms": "./dist/components/organisms/index.ts",
    "./components/templates": "./dist/components/templates/index.ts",
    "./composables": "./dist/composables/index.ts",
    "./constants": "./dist/constants/index.ts",
    "./enums": "./dist/enums/index.ts",
    "./presets": "./dist/presets/index.ts",
    "./types": "./dist/types/index.d.ts",
    "./utilities": "./dist/utilities/index.ts",
    "./tailwind-preset": "./dist/tailwind-preset.ts",
    "./styles/*": "./dist/styles/*",
    "./locales/*": "./dist/locales/*",
    "./icons/*": "./dist/icons/*",
    "./images/*": "./dist/images/*",
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node scripts/pack.mjs",
    "validate:types": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest",
    "check-locales": "node scripts/check-locales.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.4.0",
    "sass": "^1.106.1",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@headlessui/vue": "^1.7.23",
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/lodash-es": "^4.17.12",
    "@vee-validate/yup": "^4.15.1",
    "@vueuse/components": "^14.4.0",
    "dompurify": "^3.4.17",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.2",
    "maska": "^3.2.2",
    "nouislider": "^15.8.1",
    "reka-ui": "~2.9.10",
    "swiper": "12.2.0",
    "utility-types": "^3.11.0",
    "vee-validate": "^4.15.1",
    "vue-html-secure": "^1.0.10",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "sass": "^1.106.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4",
    "vue-tsc": "3.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.17.0"
}
